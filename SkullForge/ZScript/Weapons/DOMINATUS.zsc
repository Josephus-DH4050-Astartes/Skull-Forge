class SF_Dominatus : Weapon 
{
    Default
    {
        //$Title Dominatus DBR-6
        //$Sprite SGN2A0
        //$Category Weapons
        //$Colour 14
        Weapon.SelectionOrder 400;
        Weapon.AmmoUse 2;
        Weapon.AmmoGive 16;
        Weapon.AmmoType "SF_Shells";
        Obituary "\cb%o \umhas vaporized by \cr%k's \cmDBR-6.";
        Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbDominatus DBR-6 \c*(SLOT 3)";
        Tag "Dominatus DBR-6";
        Inventory.PickupSound "weapons/dominatus/up";
        Weapon.KickBack 200;
    }

    action void A_DominatusRecoil()
    {
        if (!invoker.owner) return;
        
        double p = invoker.owner.pitch;
        double a = invoker.owner.angle;
        
        // Set this to whatever maximum push force you want
        double basePower = 16.0; 
        double power = 0;
        
        // 1. Determine the raw power depending on if we are grounded or airborne
        if (invoker.owner.pos.Z <= invoker.owner.floorz)
        {
            // Grounded: Flat, equal power no matter where you look
            power = basePower;
        }
        else
        {
            // Airborne: Scale power based on pitch
            // abs(p) makes looking UP (-90) and DOWN (90) both equal to 90.
            // pitchFactor becomes 0.0 at horizon, and 1.0 at straight up/down.
            double pitchFactor = clamp(abs(p) / 90.0, 0.0, 1.0);
            
            // Scales smoothly from 0.25 (Quarter power) to 1.0 (Full power)
            double scale = 0.8 + (0.75 * pitchFactor);
            power = basePower * scale;
        }
        
        // 2. Split the power into Horizontal and Vertical forces based on barrel pitch
        // cos(pitch) gives us the horizontal intensity (Max at 0, Zero at 90)
        double hThrust = power * cos(p);
        
        // sin(pitch) gives us the vertical intensity (Zero at 0, Max at 90)
        // In GZDoom, positive pitch is looking DOWN. sin(positive) is positive.
        // We need positive Z velocity to push the player UP. So this lines up perfectly!
        double zThrust = power * sin(p);
        
        // 3. Apply the forces
        invoker.owner.Thrust(hThrust, a + 180); // Push backwards horizontally
        invoker.owner.Vel.Z += zThrust;         // Push up/down vertically
    }

    States
    {
        Deselect:
            TNT1 A 0 A_StartSound("weapons/dominatus/down", CHAN_5);
            SHT2 A 1 Offset(0, 32);
            SHT2 A 1 Offset(-8, 48);
            SHT2 A 1 Offset(-16, 64);
            SHT2 A 1 Offset(-24, 72);
            SHT2 B 1 Offset(-32, 86);
            SHT2 B 1 Offset(-48, 96);
            SHT2 B 1 Offset(-52, 112);
            SHT2 B 1 Offset(-64, 128);
        ReadlDeselect:
            TNT1 A 0 A_Lower();
            Loop;
            
        Select:
            TNT1 A 0 A_Raise();
            Loop;
            
        Ready:
            TNT1 A 0 A_StartSound("weapons/dominatus/up", CHAN_5);
            SHT2 B 1 Offset(-64, 128);
            SHT2 B 1 Offset(-52, 112);
            SHT2 B 1 Offset(-48, 96);
            SHT2 B 1 Offset(-32, 86);
            SHT2 A 1 Offset(-24, 72);
            SHT2 A 1 Offset(-16, 64);
            SHT2 A 1 Offset(-8, 48);
            SHT2 A 1 Offset(0, 32);
        RealReady:
            SHT2 A 1 A_WeaponReady();
            Loop;
            
        Fire:
            TNT1 A 0 A_FireBullets(7.8, 6.3, 18, 6, "SF_DominatusPuff");
            TNT1 AAAAAAAAAAAAAAAA 0 A_FireProjectile("SF_DominatusTracer", frandom(-3.9, 3.9), false, 0, 0, 0, frandom(-3.15, 3.15));
            TNT1 A 0 A_SetPitch(invoker.owner.pitch - 8.0);
            TNT1 A 0 A_ZoomFactor(0.97);
            TNT1 A 0 A_Quake(2, 6, 0, 1, "");
            TNT1 A 0 Offset(-1, 32) A_StartSound("weapons/dominatus/fire", CHAN_WEAPON);
            TNT1 A 0 Offset(0, 32) A_GunFlash();
            SHT2 A 1 Bright A_DominatusRecoil();
            TNT1 A 0 A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Bright Offset(0, 40) A_ZoomFactor(1.0);
            TNT1 A 0 A_SetPitch(invoker.owner.pitch + 0.5);
            
        Fire_Continue:
            TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage", 1, "QUAD_Sound_Fire");
            Goto QUAD_Nosound_Fire;
            
        QUAD_Sound_Fire:
            TNT1 A 0 A_StartSound("powerups/quad/attack", CHAN_5);
        QUAD_Nosound_Fire:
            SHT2 A 1 Bright Offset(0, 48) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Bright Offset(0, 54) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Bright Offset(0, 60) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Bright Offset(0, 64) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Bright Offset(0, 68) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 70) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 72) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 2 Offset(0, 73) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 72) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 70) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 66) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 62) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 1 Offset(0, 54) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 A 2 Offset(0, 46) A_SetPitch(invoker.owner.pitch + 0.5);
            SHT2 AA 1 Offset(0, 42) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB);
            SHT2 AA 1 Offset(0, 34) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB);
            SHT2 AAA 1 Offset(0, 32) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB);
            SHT2 AA 1 Offset(4, 32) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB);
            SHT2 AA 1 Offset(8, 33) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB);
            SHT2 A 1 Offset(16, 34);
            SHT2 A 1 Offset(24, 35);
            SHT2 B 1 Offset(16, 36) A_StartSound("weapons/dominatus/unload", CHAN_7);
            SHT2 B 1 Offset(24, 35);
            SHT2 B 1 Offset(32, 34);
            SHT2 C 1 Offset(24, 33);
            SHT2 C 1 Offset(32, 32);
            SHT2 C 1 Offset(40, 32);
            SHT2 D 1 Offset(38, 32);
            SHT2 D 1 Offset(40, 32);
            SHT2 D 1 Offset(40, 32);
            SHT2 E 1 Offset(40, 32);
            SHT2 E 1 Offset(40, 32);
            SHT2 E 1 Offset(40, 32);
            SHT2 E 1 Offset(40, 32) A_StartSound("weapons/dominatus/load", CHAN_7);
            SHT2 F 2 Offset(44, 32);
            SHT2 F 2 Offset(45, 32);
            SHT2 F 3 Offset(46, 32);
            SHT2 F 2 Offset(44, 32);
            SHT2 G 2 Offset(32, 32);
            SHT2 G 2 Offset(24, 32);
            SHT2 G 1 Offset(16, 32);
            SHT2 G 1 Offset(8, 32);
            SHT2 A 1 Offset(0, 32);
            SHT2 A 1 Offset(-4, 33);
            SHT2 A 1 Offset(-8, 34);
            SHT2 A 2 Offset(-10, 35);
            SHT2 A 3 Offset(-11, 36);
            SHT2 A 2 Offset(-10, 35);
            SHT2 A 1 Offset(-8, 34);
            SHT2 A 1 Offset(-4, 33) A_ReFire();
            SHT2 A 1 Offset(-2, 32) A_ReFire();
            SHT2 A 1 Offset(0, 32) A_ReFire();
            Goto RealReady;
            
        Flash:
            SH2F A 3 Bright A_Light1();
            SH2F B 4 Bright A_Light2();
            Goto LightDone;
            
        Spawn:
            SGN2 A -1;
            Stop;
    }
}

class SF_DominatusTracer : FastProjectile
{
    Default
    {
        Speed 115;
        Radius 1;
        Height 1;
        Damage 0;
        +PAINLESS;
        +NOBLOOD;
        -BLOODSPLATTER;
    }
    
    States
    {
        Spawn:
            TNT1 A 1;
            // A_SpawnItem is deprecated in ZScript. A_SpawnItemEx takes (type, x, y, z...)
            TNT1 A 0 A_SpawnItemEx("SF_DominatusTracerEffect", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
            TNT1 A 0 A_SpawnItemEx("SF_DominatusTracerEffect", -8, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
            TNT1 A 0 A_SpawnItemEx("SF_DominatusTracerEffect", -16, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION);
            Loop;
            
        Death:
            TNT1 A 0;
            Stop;
    }
}

class SF_DominatusTracerEffect : Actor
{
    Default
    {
        +NOGRAVITY;
        RenderStyle "Add";
        Alpha 0.8;
        +NOINTERACTION;
        +BRIGHT;
    }
    
    States
    {
        Spawn:
            HORB B 1 A_SetScale(1.0, 1.0);
            HORB B 1 A_SetScale(0.6, 0.6);
            HORB B 1 A_SetScale(0.2, 0.2);
            Stop;
    }
}

class SF_DominatusPuff : Actor
{   
    Default
    {
        +NOGRAVITY;
    }
    
    States
    {
        Spawn:
            TNT1 A 0;
            TNT1 A 0 A_StartSound("effect/richoshete", CHAN_BODY);
            PULF AAABBBCCCDDD 1 A_SpawnItemEx("SF_DominatusPuffDeathEffect", frandom(-0.8, 0.8), frandom(-0.8, 0.8), frandom(-2.8, 2.8), frandom(-2.8, 2.8), frandom(0, 1.9), 0, 0, SXF_NOCHECKPOSITION);
            Stop;
            
        XDeath:
            TNT1 A 0;
            Stop;
    }
}

class SF_DominatusPuffDeathEffect : Actor
{
    Default
    {
        +BRIGHT;
        RenderStyle "Add";
        Alpha 0.2;
        Scale 0.25;
        Gravity 0.1;
    }
    
    States
    {
        Spawn:
            HORB BB 1 A_SetScale(1.0, 1.0);
            HORB BB 1 A_SetScale(0.9, 0.9);
            HORB BB 1 A_SetScale(1.0, 1.0);
            HORB BB 1 A_SetScale(0.9, 0.9);
            HORB B 1 A_SetScale(1.0, 1.0);
            HORB B 1 A_SetScale(0.7, 0.7);
            HORB B 1 A_SetScale(0.4, 0.4);
            HORB B 1 A_SetScale(0.1, 0.1);
            Stop;
    }
}
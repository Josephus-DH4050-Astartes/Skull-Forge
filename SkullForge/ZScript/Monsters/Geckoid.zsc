class SF_Geckoid : Actor
{
    Default
    {
        //$Title "Geckoid"
        //$Sprite "TROOG3"
        //$Category "Monster/Geckoidal"
        Health 40;
        Radius 20;
        Height 56;
        Mass 100;
        Speed 14;
        PainChance 200;
        Monster;
        +FLOORCLIP
        +NOINFIGHTING
        BloodColor "Green";
        SeeSound "monsters/geckoid/see";
        PainSound "monsters/geckoid/pain";
        DeathSound "monsters/geckoid/death";
        ActiveSound "monsters/geckoid/active";
        HitObituary "%o was Ganked by a Geckoid";
        Obituary "%o was Grilled by a Geckoid";
        MaxStepHeight 24; 
    }

    // Changed to bool.
    bool TryVaultWall()
    {
        if (pos.z > floorz) return false;

        FLineTraceData traceData;
        bool hit = LineTrace(angle, radius + 12.0, 0, TRF_THRUACTORS, 16.0, 0, 0, traceData);

        if (hit && traceData.HitType == TRACE_HitWall)
        {
            Line hitLine = traceData.HitLine;
            
            if (hitLine.flags & (Line.ML_BLOCKING | Line.ML_BLOCKMONSTERS | Line.ML_BLOCKEVERYTHING))
                return false;

            if (hitLine && hitLine.backsector)
            {
                Sector otherSector = (hitLine.frontsector == traceData.HitSector) ? hitLine.backsector : hitLine.frontsector;

                if (otherSector)
                {
                    double targetFloorZ = otherSector.floorplane.ZAtPoint(traceData.HitLocation.XY);
                    double targetCeilZ = otherSector.ceilingplane.ZAtPoint(traceData.HitLocation.XY);
                    double stepHeight = targetFloorZ - pos.z;

                    if (stepHeight > 24.0 && stepHeight < 128.0 && (targetCeilZ - targetFloorZ) >= Height)
                    {
                        A_FaceTarget(); 
                        A_StartSound("monsters/geckoid/jump", CHAN_VOICE);
                        
                        // Apply vertical jump only
                        vel.z = sqrt(stepHeight * 2.0) + 1.0; 
                        return true;
                    }
                }
            }
        }
        return false;
    }

    States
    {
    Spawn:
        TROO AB 10 A_Look();
        Loop;
    See:
        TROO AABBCCDD 3 
        {
            A_Chase();
            if (TryVaultWall()) return ResolveState("VaultLedge");
            return ResolveState(null);
        }
        Loop;
        
    // NEW STATE: Pushes the Geckoid forward over the ledge
    VaultLedge:
        TROO A 1 Fast
        {
            // Geckoid is faster, so give him a slightly stronger forward vault speed
            vel.x = cos(angle) * 6.0;
            vel.y = sin(angle) * 6.0;
            
            // If landed, resume chasing
            if (vel.z <= 0 && pos.z <= floorz) return ResolveState("See");
            return ResolveState(null);
        }
        Loop;

    Missile:
        TROO EF 6 A_FaceTarget();
        TROO G 6 
        {
            A_SpawnProjectile("SF_GeckoidBall", 36, 18);
            A_SpawnProjectile("SF_GeckoidBall", 36, -18);
        }
        Goto See;
    Pain:
        TROO H 2;
        TROO H 2 A_Pain();
        Goto See;
    Death:
        TROO I 8 A_SetTranslation("GeckoidGreen");
        TROO J 8 A_Scream();
        TROO K 6;
        TROO L 6 A_NoBlocking();
        TROO M -1;
        Stop;
    XDeath:
        TROO N 5 A_SetTranslation("GeckoidGreen");
        TROO O 5 A_XScream();
        TROO P 5;
        TROO Q 5 A_NoBlocking();
        TROO RST 5;
        TROO U -1;
        Stop;
    Raise:
        TROO ML 8;
        TROO KJI 6;
        Goto See;
    }
}
class SF_GeckoidBall : Actor
{
    Default
    {
        Projectile;
        Radius 3;
        Height 4;
        Scale 0.5;
        DamageFunction (10);
        Speed 12;
        FastSpeed 24;
        +RANDOMIZE
        RenderStyle "Add";
        Alpha 0.75;
        SeeSound "monsters/geckoid/missile/fire";
        DeathSound "monsters/geckoid/missile/explode";
    }

    States
    {
    Spawn:
        BAL1 AAAABBBB 1 Bright A_SpawnItemEx("SF_GeckoidTrail");
        Loop;
    Death:
        TNT1 AAAA 0 A_SpawnItemEx("SF_GeckoidTrail", random(-2,2), random(-2,2), random(-2,2), frandom(-2.5,2.5), frandom(-2.5,2.5), frandom(-2.5,2.5));
        BAL1 CDE 4 Bright;
        Stop;
    }
}

class SF_GeckoidTrail : Actor
{
    Default
    {
        +NOBLOCKMAP
        +NOGRAVITY
        RenderStyle "Add";
        Alpha 0.25;
        Scale 0.4;
    }

    States
    {
    Spawn:
        BAL1 A 1 A_SetScale(0.4);
        BAL1 A 1 A_SetScale(0.35);
        BAL1 B 1 A_SetScale(0.3);
        BAL1 B 1 A_SetScale(0.25);
        BAL1 A 1 A_SetScale(0.2);
        BAL1 A 1 A_SetScale(0.15);
        BAL1 B 1 A_SetScale(0.1);
        BAL1 B 1 A_SetScale(0.05);
        Stop;
    }
}
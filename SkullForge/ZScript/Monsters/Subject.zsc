class SF_Subject : Actor
{
    Default
    {
        //$Category "Monster/Post-Human"
        //$Title "Subject (Guarding)"
        //$Arg0 "Asleep"
        //$Arg0Tooltip "If set to 1 the Subject will appear as a corpse before getting close"
        //$Color 12
        Monster;
        Health 60;
        Radius 16;
        Height 54;
        Mass 80;
        Speed 4;
        PainChance 200;
        SeeSound "monsters/subject/see";
        ActiveSound "monsters/subject/active";
        PainSound "monsters/subject/pain";
        DeathSound "monsters/subject/death";
        MeleeRange 32;
    }

    // Changed to a bool. Returns TRUE if a climb is initiated.
    bool TryClimbWall()
    {
        // Don't attempt to jump if already in mid-air
        if (pos.z > floorz) return false;

        FLineTraceData traceData;
        bool hit = LineTrace(angle, radius + 16.0, 0, TRF_THRUACTORS, 8.0, 0, 0, traceData);

        if (hit && traceData.HitType == TRACE_HitWall)
        {
            Line hitLine = traceData.HitLine;
            
            if (hitLine.flags & (Line.ML_BLOCKING | Line.ML_BLOCKMONSTERS | Line.ML_BLOCKEVERYTHING))
                return false;

            if (hitLine && hitLine.backsector)
            {
                Sector otherSector = (hitLine.frontsector == traceData.HitSector) ? hitLine.backsector : hitLine.frontsector;

                if (otherSector)
                {
                    double targetFloorZ = otherSector.floorplane.ZAtPoint(traceData.HitLocation.XY);
                    double targetCeilZ = otherSector.ceilingplane.ZAtPoint(traceData.HitLocation.XY);
                    double stepHeight = targetFloorZ - pos.z;

                    if (stepHeight > 24.0 && stepHeight < 64.0 && (targetCeilZ - targetFloorZ) >= Height)
                    {
                        // ONLY apply vertical thrust initially.
                        vel.z = sqrt(stepHeight * 2.0) + 1.0; 
                        return true;
                    }
                }
            }
        }
        return false;
    }

    States
    {
    Spawn:
        TNT1 A 0 A_JumpIf(args[0] == 1, "Spawn_Lay");
        SUBJ AABB 8 A_Look();
        Loop;
    Spawn_Lay:
        SUBJ M 1 
        {
            A_LookEx(LOF_NOSOUNDCHECK, 0, 256, 0, 360, "Jump");
            A_SetSize(16, 13);
            A_ChangeFlag("ALWAYSPAIN", true); 
        }
        Loop;
    Jump:
        SUBJ L 2 
        {
            ThrustThingZ(0, 32, 0, 0);
            A_SetSize(16, 24);
            args[0] = 0; 
        }
        SUBJ K 2 A_SetSize(16, 38);
        SUBJ J 4 A_SetSize(16, 48);
        SUBJ I 2 A_SetSize(16, 54);
    See:
        SUBJ AAAA 4 Fast 
        {
            A_Chase();
            // If the climb function succeeds, jump to the ClimbLedge state
            if (TryClimbWall()) { return ResolveState("ClimbLedge"); }
            A_SetTics(random(1, 5));
            return ResolveState(null);
        }
        SUBJ BBBB 2 Fast A_Chase();
        SUBJ CCCC 2 Fast A_Chase();
        SUBJ DDDD 2 Fast A_Chase();
        TNT1 A 0 
        {
            A_StartSound("monsters/subject/step", CHAN_BODY);
            Speed = random(1, 9); 
        }
        Loop;
    
    // NEW STATE: Constantly pushes the monster forward while in the air
    ClimbLedge:
        SUBJ A 1 Fast
        {
            // Simulate holding the "W" key while jumping.
            // As soon as their Z-height clears the wall, this will pull them onto the ledge.
            vel.x = cos(angle) * 4.0;
            vel.y = sin(angle) * 4.0;
            
            // If we have landed back on the ground, resume chasing
            if (vel.z <= 0 && pos.z <= floorz) return ResolveState("See");
            return ResolveState(null);
        }
        Loop;

    Melee:
        TNT1 A 0 A_StartSound("monsters/subject/attack", CHAN_VOICE);
        SUBJ EE 3 Fast 
        {
            A_FaceTarget();
            A_SetTics(random(1, 6));
        }
        TNT1 A 0 
        {
            A_Recoil(-5);
            ThrustThingZ(0, 24, 0, 0);
        }
        SUBJ E 2 Fast;
        SUBJ FFFF 2 Fast A_CustomMeleeAttack(3, "monsters/subject/hit", "", 'Melee', true);
        SUBJ GGGG 3 Fast A_FaceTarget();
        Goto See;
    Pain:
        TNT1 A 0 A_JumpIf(args[0] == 1, "Jump");
        SUBJ H 3 Fast; 
        SUBJ H 3 Fast A_Pain();
        Goto See;
    Death:
        SUBJ I 4 A_Scream();
        SUBJ J 8 A_NoBlocking();
        SUBJ KL 4;
        SUBJ M -1;
        Stop;
    }
}

class SF_Subject_Wander : SF_Subject
{
    Default
    {
        //$Category "Monster/Post-Human"
        //$Title "Subject (Wandering)"
        //$ClearArgs
        //$Color 12
    }
    
    States
    {
    Spawn:
        TNT1 A 0 A_StartSound("monsters/subject/step", CHAN_BODY);
        SUBJ AAAA 6 Fast { A_Look(); A_Wander(); if (TryClimbWall()) return ResolveState("WanderClimbLedge"); return ResolveState(null); }
        SUBJ BBBB 4 Fast { A_Look(); A_Wander(); if (TryClimbWall()) return ResolveState("WanderClimbLedge"); return ResolveState(null); }
        SUBJ CCCC 4 Fast { A_Look(); A_Wander(); if (TryClimbWall()) return ResolveState("WanderClimbLedge"); return ResolveState(null); }
        SUBJ DDDD 4 Fast { A_Look(); A_Wander(); if (TryClimbWall()) return ResolveState("WanderClimbLedge"); return ResolveState(null); }
        Loop;
        
    // Separate climb state for wanderers so they don't accidentally "wake up" after jumping
    WanderClimbLedge:
        SUBJ A 1 Fast
        {
            vel.x = cos(angle) * 4.0;
            vel.y = sin(angle) * 4.0;
            if (vel.z <= 0 && pos.z <= floorz) return ResolveState("Spawn");
            return ResolveState(null);
        }
        Loop;
    }
}
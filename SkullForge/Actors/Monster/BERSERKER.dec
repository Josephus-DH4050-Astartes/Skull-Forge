ACTOR SF_Berserker 30111
{
	//$Title Berserker
	//$Sprite LIBRC1
	//$Category Monster/Descian
	Health 300
	Radius 20
	Height 56
	Mass 100
	Speed 18
	Scale 0.90
	PainChance 200
	MeleeRange 96
	Monster
	+FLOORCLIP
	+NOINFIGHTING
	SeeSound "monsters/berserker/see"
	PainSound "monsters/berserker/pain"
	DeathSound "monsters/berserker/death"
	ActiveSound "monsters/berserker/active"
	Obituary "%o got pummeled by a Descian Berserker."
	States
	{
		Spawn:
			LIBR AB 10 A_Look
			Loop
		See:
			LIBR AABBCCDD 3 A_Chase
			Loop
		Melee:
			LIBR EE 3 A_FaceTarget
			TNT1 A 0 A_PLaySound("monsters/berserker/attack",CHAN_BODY)
			LIBR FF 3 A_FaceTarget
			LIBR G 8 A_CustomMeleeAttack(random(1, 10) * 6, "demon/melee")
			LIBR G 0 A_JumpIfTargetInsideMeleeRange("SecondMelee")
			Goto See
		SecondMelee:
			LIBR HH 3 A_FaceTarget
			TNT1 A 0 A_PLaySound("monsters/berserker/attack",CHAN_BODY)
			LIBR II 3 A_FaceTarget
			LIBR J 8 A_CustomMeleeAttack(random(1, 10) * 6, "imp/melee")
			Goto See
		Pain:
			LIBR K 2
			LIBR K 2 A_Pain
			Goto See
		Death:
			LIBR M 4
			LIBR N 4 A_Scream
			LIBR O 4 A_NoBlocking
			LIBR P 4 A_QueueCorpse
			LIBR QRST 4
			LIBR U -1
			Stop
	}
}
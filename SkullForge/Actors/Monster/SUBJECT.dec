Actor SF_Subject 3300
{
    //$category Monster/Post-Human
    //$title Subject (Guarding)
    //$Arg0 Asleep
    //$Arg0Tooltip If set to 1 the Subject will apear as a corpse before getting close
    //$Color 12
    Monster
    Health 60
    Radius 16
    Height 54
    Mass 80
    Speed 4
    PainChance 200
    SeeSound "monsters/subject/see"
    ActiveSound "monsters/subject/active"
    PainSound "monsters/subject/pain"
    DeathSound "monsters/subject/death"
    MeleeRange 32
    States
    {
        Spawn:
            TNT1 A 0 A_JumpIf(Args[0] == 1, "Spawn_Lay")
            SUBJ AABB 8 A_Look
            Loop
        Spawn_Lay:
            SUBJ M 1 {
                A_LookEx(LOF_NOSOUNDCHECK,0,256,0,360,"Jump");
                A_SetSize(16,13);
                A_ChangeFlag("ALWAYSPAIN",1);
            }
            Loop
        Jump:
            SUBJ L 2 {
                ThrustThingZ(0,32,0,0);
                A_SetSize(16,24);
                A_SetArg(0,0);
            }
            SUBJ K 2 A_SetSize(16,38)
            SUBJ J 4 A_SetSize(16,48)
            SUBJ I 2 A_SetSize(16,54)
        See:
            SUBJ AAAA 4 Fast {
                A_Chase;
                A_SetTics(Random(1,7));
            }
            SUBJ BBBB 2 Fast A_Chase
            SUBJ CCCC 2 Fast A_Chase
            SUBJ DDDD 2 Fast A_Chase
            TNT1 A 0 {
                A_PlaySound("monsters/subject/step",CHAN_BODY);
                A_SetSpeed(Random(1,9));
            }
            Loop
        Melee:
            TNT1 A 0 A_PlaySound("monsters/subject/attack",CHAN_VOICE)
            SUBJ EEEEEE 3 Fast {
                A_FaceTarget;
                A_SetTics(Random(1,3));
            }
            TNT1 A 0 {
                A_Recoil(-5);
                ThrustThingZ(0,24,0,0);
            }
            SUBJ F 2 Fast A_CustomMeleeAttack((13),"monsters/subject/hit","",0,TRUE)
            SUBJ FFF 2 Fast A_FaceTarget
            SUBJ GGGG 3 Fast A_FaceTarget
            Goto See
        Pain:
            TNT1 A 0 A_JumpIf(Args[0] == 1, "Jump")
            SUBJ H 3 Fast 
            SUBJ H 3 Fast A_Pain
            Goto See
        Death:
            SUBJ I 4 A_Scream
            SUBJ J 8 A_NoBlocking
            SUBJ KL 4
            SUBJ M -1
            Stop
    }
}

Actor SF_Subject_Wander : SF_Subject 3301
{
    //$category Monster/Post-Human
    //$title Subject (Wandering)
    //$ClearArgs
    //$Color 12
    States
    {
        Spawn:
            TNT1 A 0 A_PlaySound("monsters/subject/step",CHAN_BODY)
            SUBJ AAAA 6 Fast { A_Look; A_Wander; }
            SUBJ BBBB 4 Fast { A_Look; A_Wander; }
            SUBJ CCCC 4 Fast { A_Look; A_Wander; }
            SUBJ DDDD 4 Fast { A_Look; A_Wander; }
            Loop
    }
}
ACTOR SF_Descian 30112
{
	//$Title Descian
	//$Sprite LVMDE1
	//$Category Monster/Descian
	Health 350
	Speed 19
	Radius 32
	Height 64
	Mass 400
	Scale 1.1
	PainChance 90
	ReactionTime 8
	MinMissileChance 90
	BloodColor "Green"
	MONSTER
	+NOINFIGHTING
	+DONTGIB
	+FLOORCLIP
	+AVOIDMELEE
	+MISSILEMORE
	+DONTHARMCLASS
	+DONTHARMSPECIES
	SeeSound "Lavamander/sight"
	PainSound "Lavamander/pain"
	DeathSound "Lavamander/death"
	ActiveSound "Lavamander/active"
	Obituary "%o was melted by a Descian Trooper."
	States
	{
	Spawn:
		LVMD AB 10 A_Look
		Loop
	See:
		TNT1 A 0 A_Jump(32, "See2")
		LVMD A 0 A_PlaySound("Lavamander/walk")
		LVMD AABB 5 A_Chase
		LVMD C 0 A_PlaySound("Lavamander/walk")
		LVMD CCDD 5 A_Chase
		Loop
	See2:
		LVMD A 0 A_PlaySound("Lavamander/walk")
		LVMD AB 5 A_Chase
		LVMD C 0 A_PlaySound("Lavamander/walk")
		LVMD CD 5 A_Chase
		LVMD A 0 A_PlaySound("Lavamander/walk")
		LVMD AB 5 A_Chase
		LVMD C 0 A_PlaySound("Lavamander/walk")
		LVMD CD 5 A_Chase
		Goto See
	Missile:
		LVMD EF 5 A_FaceTarget
		LVMD G 0 A_PlaySound("Lavamander/attack", 1)
		LVMD G 8 A_CustomMissile("LavamanderBall", 48, 0, frandom(-1, 1))
		LVMD FE 5 A_FaceTarget
		LVMD E 0 A_Jump(128, "See")
		LVMD EF 5 A_FaceTarget
		LVMD G 0 A_PlaySound("Lavamander/attack", 5)
		LVMD G 0 A_CustomMissile("LavamanderBall", 48, 0, frandom(-5, -3))
		LVMD G 8 A_CustomMissile("LavamanderBall", 48, 0, frandom(3, 5))
		LVMD FE 5 A_FaceTarget
		LVMD E 0 A_Jump(128, "See")
		LVMD EF 5 A_FaceTarget
		LVMD G 0 A_PlaySound("Lavamander/attack", 7)
		LVMD G 0 A_CustomMissile("LavamanderBall", 48, 0, frandom(-5, -3))
		LVMD G 0 A_CustomMissile("LavamanderBall", 48, 0, frandom(-1, 1))
		LVMD G 8 A_CustomMissile("LavamanderBall", 48, 0, frandom(3, 5))
		LVMD FE 5 A_FaceTarget
		Goto See
	Pain:
		LVMD H 3
		LVMD H 3 A_Pain
		Goto See
	Death:
		LVMD I 8
		LVMD J 8 A_Scream
		LVMD KLM 7
		LVMD N 7 A_NoBlocking
		LVMD O -1
		Stop
    Raise: 
        LVMD ONMLKJI 5 
        Goto See 
	}
}

ACTOR LavamanderBall
{
	Radius 15
	Height 12
	Speed 16
	FastSpeed 21
	Damage 12
	PROJECTILE
	+RANDOMIZE
	SeeSound "Weapons/rocklf"
	DeathSound "weapons/rocklx"
	RenderStyle Add
	Decal "BigScorch"
	DamageType "Fire"
	States
	{
	Spawn:
		LVMB AB 2 Bright A_SpawnItemEx("LavamanderBallSmokeTrail", frandom(-1, 1), frandom(-1, 1), frandom(-1, 1), frandom(-1, 1), frandom(-1, 1), frandom(-1, 1))
		Loop
	Death:
		TNT1 A 0 A_Quake(1, 24, 0, 512)
		LVMB C 8 Bright A_Explode(10, 64, 0)
		LVMB D 6 Bright
		LVMB E 4 Bright
		Stop
	}
}
ACTOR LavamanderBallSmokeTrail
{
	+NOBLOCKMAP
	+NOGRAVITY
	+ALLOWPARTICLES
	+RANDOMIZE
	+NOINTERACTION
	RenderStyle Add
	Alpha 0.75
	Scale 0.8
	States
	{
	Spawn:
		RPUF AAAABBBBCCCCDDDD 1 Bright A_FadeOut(0.05)
		Stop
	}
}
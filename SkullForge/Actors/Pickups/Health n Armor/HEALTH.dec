Actor SF_AdrenalinePack : CustomInventory 2023
{
    //$Title Adrenaline Pack
    //$Category Health and Armor
    //$Colour 1
    //$Sprite MEDKC0
    //$NotAngled
    Inventory.PickupMessage "\cqHEALTH AQUIRED: \cbAdrenaline Pack \c*(FULL HEAL + SPEED BOOST)"
    States
    {
        Spawn:
            MEDK C -1
            Stop
        Pickup:
            TNT1 A 0
            {
                A_GiveInventory("SF_AP_Health", 100);
                A_GiveInventory("SF_AP_Speed", 1);
                A_GiveInventory("SF_AP_Fire", 1);
            }
            Stop
    }
}

Actor SF_AP_Health : Health
{
    Inventory.Amount 100
    Inventory.MaxAmount 100
    +INVENTORY.ALWAYSPICKUP
}

Actor SF_AP_Speed : PowerUpGiver
{
    PowerUp.Type "_AP_Speed"
    PowerUp.Duration -20
    Inventory.MaxAmount 0
    Powerup.Colormap 0.078, 0.145, 0.200, 0.0, 0.561, 1.0
    +INVENTORY.AUTOACTIVATE
    +INVENTORY.ALWAYSPICKUP
}

Actor Power_AP_Speed : PowerSpeed
{
    Speed 4.0
    +INVENTORY.NOTELEPORTFREEZE
}

Actor SF_AP_Fire : PowerUpGiver
{
    PowerUp.Type "_AP_Fire"
    PowerUp.Duration -20
    Inventory.MaxAmount 0
    +INVENTORY.AUTOACTIVATE
    +INVENTORY.ALWAYSPICKUP
}

Actor Power_AP_Fire : PowerDoubleFiringSpeed {}
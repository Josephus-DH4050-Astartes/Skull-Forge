Actor SF_HealthVial : Health 2014
{
    //$Title Health Vial
    //$Category Health and Armor
    //$Colour 1
    //$Sprite HPBVA0
    //$NotAngled
    Inventory.Amount 2
    Inventory.MaxAmount 200
    Inventory.PickupMessage "\cqHEALTH AQUIRED: \cbHP Bonus \c*(+2 HP)"
    Health.LowMessage 25, "\cqHEALTH AQUIRED: \cbHP Bonus \c*(+2 HP) \cl[CRITICAL CONDITION]"
    States
    {
        Spawn:
            HPBV A -1
            Stop
    }
}

